RewriteEngine On

# 1. Hapus ekstensi .php dari URL browser untuk request GET/HEAD (User-friendly URLs)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteCond %1 !index$
RewriteRule ^ %1 [R=301,L]

# 2. Jika request diawali dengan lautan-ternak-pantura/, potong path tersebut agar berfungsi di shared hosting
RewriteRule ^lautan-ternak-pantura/(.*)$ $1 [QSA]

# 3. Sajikan favicon secara langsung bahkan jika diminta dari root domain
RewriteRule ^favicon\.ico$ assets/images/favicon.ico [L]

# 4. Jika request (tanpa .php) adalah file .php yang valid di server, maka proses file tersebut
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*)$ $1.php [L]

# 4. Jika file atau folder fisik ada (misal aset gambar, css, js), biarkan dilayani langsung
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 5. Routing MVC untuk path dinamis lainnya (diarahkan ke index.php)
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
